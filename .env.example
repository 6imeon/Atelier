# Required: OpenRouter API key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# Optional: API authentication key — if set, all POST endpoints require
# Authorization: Bearer <key> header. Leave blank for open access (dev mode).
# ATELIER_API_KEY=your-secret-key-here
# VITE_ATELIER_API_KEY=your-secret-key-here   # Same key, for the web-ui (Vite exposes VITE_ prefixed vars)

# Optional: override model per pipeline stage
# Defaults shown below — Kimi K2.6 for generation (K2.5 as fallback), DeepSeek V3 for parsing/code
# CANVAS_MODEL_INTENT_PARSE=deepseek/deepseek-chat-v3-0324
# CANVAS_MODEL_VISION_INTERPRET=moonshotai/kimi-k2.6
# CANVAS_MODEL_LAYOUT_GENERATE=moonshotai/kimi-k2.6
# CANVAS_MODEL_DESIGN_REFINE=moonshotai/kimi-k2.6
# CANVAS_MODEL_CODE_RENDER=deepseek/deepseek-chat-v3-0324
# CANVAS_MODEL_DESIGN_EXTRACT=deepseek/deepseek-chat-v3-0324
# CANVAS_MODEL_SECTION_GENERATE=moonshotai/kimi-k2.6

# crawl4ai URL — auto-set to http://crawl4ai:11235 inside Docker
# Uncomment to use locally without Docker:
# CRAWL4AI_URL=http://localhost:11235

# Storage: sqlite (default, persistent) | memory (ephemeral, lost on restart)
ATELIER_STORAGE=sqlite
ATELIER_STORAGE_PATH=./data/canvas.db

# Auth mode: "apikey" (default) | "entra" | "both"
# AUTH_MODE=apikey

# Microsoft 365 / Entra ID gate — set to false to disable Microsoft sign-in
# entirely (server falls back to API-key auth, UI hides the Microsoft button)
# even when AUTH_MODE/Azure IDs are configured. Defaults to true.
# ENTRA_ENABLED=false
# VITE_ENTRA_ENABLED=false   # Same gate, exposed to Vite for the web-ui

# Microsoft Entra ID (single app registration) — required when AUTH_MODE=entra or both
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-app-client-id       # Same client ID for API + SPA
# VITE_AZURE_CLIENT_ID=your-app-client-id   # Same value, exposed to Vite
# VITE_AZURE_TENANT_ID=your-tenant-id       # Same value, exposed to Vite

# MongoDB Atlas — analytics/learning layer (optional, app works without it)
# MONGO_URI=mongodb+srv://atelier:<password>@cluster0.xxxxx.mongodb.net/atelier?retryWrites=true&w=majority
