{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "declaration": true, "sourceMap": true, "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "packages/figma-plugin",
    "packages/mcp-server",
    "packages/web-ui",
    "packages/sdk/src/ai-tools.ts",
    "packages/sdk/src/__tests__",
    "scripts",
    "skills"
  ]
}
