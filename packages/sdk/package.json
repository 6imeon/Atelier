{
  "name": "@canvas-ai/sdk",
  "version": "0.1.0",
  "description": "Multi-model AI UI generation SDK via OpenRouter",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./ai": "./dist/ai-tools.js",
    "./storage/*": "./dist/storage/*.js",
    "./screenshot/*": "./dist/screenshot/*.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "acorn": "^8.12.0",
    "acorn-walk": "^8.3.0",
    "mongodb": "^7.1.1",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "ai": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "typescript": "^6.0.3",
    "vitest": "^2.0.0"
  }
}
